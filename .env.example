# ---------------------------------------------------------------------------
# Copy to .env and fill in. Never commit the real .env (it is gitignored).
# On Vercel these go in Project -> Settings -> Environment Variables instead.
# ---------------------------------------------------------------------------

# 1. Telegram ---------------------------------------------------------------
# From @BotFather -> /newbot (the bot username must end in "bot").
TELEGRAM_BOT_TOKEN=

# Any random string you invent. Telegram sends it back in the
# X-Telegram-Bot-Api-Secret-Token header so nobody else can POST to the webhook.
TELEGRAM_WEBHOOK_SECRET=change-me-to-a-random-string

# 2. LLM (AI Pipe by default) ----------------------------------------------
# Token from https://aipipe.org/login  (any OpenAI-compatible key also works:
# just change LLM_BASE_URL, e.g. https://api.openai.com/v1)
AIPIPE_TOKEN=
LLM_BASE_URL=https://aipipe.org/openai/v1
LLM_MODEL=gpt-4.1-mini
# Used if LLM_MODEL errors out (quota / model not available)
LLM_FALLBACK_MODEL=gpt-4.1-nano

# 3. Where the run log (log_url) is published -------------------------------
# "github" = commit logs/<run_id>.jsonl to a public repo -> raw.githubusercontent
#            URL. Durable, survives redeploys. Recommended on Vercel.
# "local"  = write to disk and serve it from this app at PUBLIC_BASE_URL/logs/...
#            Fine for always-on hosts (Render/Docker) and local testing.
LOG_STORE=github
GITHUB_TOKEN=
GITHUB_REPO=your-username/your-repo
GITHUB_BRANCH=main

# Public https URL of this deployment, no trailing slash.
# Needed for LOG_STORE=local and for setting the webhook.
PUBLIC_BASE_URL=https://your-app.vercel.app

# 4. Optional: better web search (all free tiers, agent works without them) --
# https://tavily.com  |  https://serper.dev  |  https://brave.com/search/api
TAVILY_API_KEY=
SERPER_API_KEY=
BRAVE_API_KEY=

# 5. Agent tuning (defaults are sensible) -----------------------------------
AGENT_MAX_STEPS=12
AGENT_TIME_BUDGET=200
# Answer the Telegram webhook within this many seconds (Telegram re-sends an
# update if it does not get a 200 within ~60s). Work continues in background.
RESPOND_AFTER_SECONDS=50
